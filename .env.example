# Copy to .env.local and fill in. Never commit .env.local.

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Cloudinary — https://console.cloudinary.com (Dashboard)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supabase — https://supabase.com (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Postgres (Project Settings → Database)
# DATABASE_URL = Transaction pooler URI, port 6543 (for runtime)
# DIRECT_URL   = Direct connection, port 5432 (for migrations)
DATABASE_URL=
DIRECT_URL=

# Only this email can sign in as the owner.
OWNER_EMAIL=
