generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Page {
  id         String    @id @default(cuid())
  title      String
  summary    String
  layoutJson String
  layoutEn   String?
  layoutZh   String?
  views      Int       @default(0)
  createdAt  DateTime  @default(now())
  entryDate  DateTime  @default(now())
  photos     Photo[]
  likes      Like[]
  comments   Comment[]
}

model Like {
  id        String   @id @default(cuid())
  pageId    String
  visitorId String
  createdAt DateTime @default(now())
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, visitorId])
  @@index([pageId])
}

model Comment {
  id         String    @id @default(cuid())
  pageId     String
  authorName String
  body       String
  createdAt  DateTime  @default(now())
  editedAt   DateTime?
  page       Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

model Photo {
  id       String  @id @default(cuid())
  pageId   String
  filePath String
  width    Int?
  height   Int?
  order    Int     @default(0)
  page     Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model Editor {
  email   String   @id
  addedAt DateTime @default(now())
  addedBy String
}
